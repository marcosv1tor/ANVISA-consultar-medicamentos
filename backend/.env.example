# Configurações de ambiente para produção
NODE_ENV=production
PORT=3001

# Configurações do Puppeteer para Render
# Usando configuração padrão - Chromium será baixado automaticamente

# URLs permitidas para CORS (adicione suas URLs do Vercel)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://anvisa-consultar-medicamentos.vercel.app